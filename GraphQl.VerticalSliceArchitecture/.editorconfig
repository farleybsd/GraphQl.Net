root = true

# Lido pelo CSharpier e também pela IDE.
[*.{cs,csx}]
charset = utf-8
indent_style = space
indent_size = 4
max_line_length = 100
insert_final_newline = true
trim_trailing_whitespace = true

[*.{config,csproj,props,targets,slnx,xml}]
indent_style = space
indent_size = 2
max_line_length = 100
