<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Permite que um PackageVersion central sobrescreva a versão de uma dependência transitiva. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Domain -->
    <PackageVersion Include="Ardalis.Specification" Version="10.0.0" />
    <PackageVersion Include="ErrorOr" Version="2.1.1" />
    <PackageVersion Include="Vogen" Version="8.0.7" />

    <!-- WebApi -->
    <PackageVersion Include="Ardalis.Specification.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.5.3" />
    <PackageVersion Include="EntityFrameworkCore.Exceptions.SqlServer" Version="10.0.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="HotChocolate.AspNetCore" Version="16.6.6" />
    <PackageVersion Include="HotChocolate.AspNetCore.CommandLine" Version="16.6.6" />
    <PackageVersion Include="HotChocolate.Data.EntityFramework" Version="16.6.6" />
    <PackageVersion Include="HotChocolate.Subscriptions.InMemory" Version="16.6.6" />
    <PackageVersion Include="HotChocolate.Types.Analyzers" Version="16.6.6" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />

    <!-- Dependência transitiva: fixada para corrigir NU1902/NU1903 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx) da 10.0.11. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />

    <!-- ServiceDefaults -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.1" />
  </ItemGroup>
</Project>
